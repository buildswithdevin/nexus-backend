# ─────────────────────────────────────────────────────────────────────────────
# NEXUS Backend — Environment Variables
# Copy this file to .env for local development.
# On Railway, set these in your service Variables tab.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI (optional — app works without this in fallback mode) ──────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# Local:  sqlite+aiosqlite:///./data/nexus.db
# Railway (mount a volume at /data): sqlite+aiosqlite:////data/nexus.db
DATABASE_URL=sqlite+aiosqlite:///./data/nexus.db

# ── Vector store ─────────────────────────────────────────────────────────────
# Local: ./data/chroma   |   Railway: /data/chroma
CHROMA_PATH=./data/chroma

# ── Embedding model (~90 MB, downloaded automatically on first run) ───────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS — add your Vercel URL here ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-nexus-app.vercel.app,chrome-extension://*

# ── Scraper ───────────────────────────────────────────────────────────────────
SCRAPER_TIMEOUT=15
MAX_CONTENT_LENGTH=8000
